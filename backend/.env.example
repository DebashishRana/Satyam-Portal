# Satyam Portal Backend Environment Variables

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/satyam

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Settings
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000"]

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=52428800

# AI/ML Settings
OCR_CONFIDENCE_THRESHOLD=0.85
LAYOUT_LM_MODEL=microsoft/layoutlmv3-base

# External APIs (Optional - for production)
DIGILOCKER_API_URL=
DIGILOCKER_API_KEY=
GSTN_API_URL=
GSTN_API_KEY=
MCA_API_URL=
MCA_API_KEY=

# Logging
LOG_LEVEL=INFO

# MeghRaj/GCC Deployment (Optional)
MEGHRAJ_ENDPOINT=
MEGHRAJ_ACCESS_KEY=
MEGHRAJ_SECRET_KEY=
