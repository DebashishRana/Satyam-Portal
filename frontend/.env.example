# Satyam Portal Frontend Environment Variables

# API Configuration
REACT_APP_API_URL=http://localhost:8000/api/v1
REACT_APP_SOCKET_URL=ws://localhost:8000

# Feature Flags
REACT_APP_ENABLE_OCR_PREVIEW=true
REACT_APP_ENABLE_REALTIME_NOTIFICATIONS=true

# External Services
REACT_APP_DIGILOCKER_URL=https://api.digitallocker.gov.in
REACT_APP_GEM_URL=https://gem.gov.in

# Security
REACT_APP_SESSION_TIMEOUT=3600000

# Build Configuration
GENERATE_SOURCEMAP=false
